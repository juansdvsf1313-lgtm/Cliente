IDI_ICON1    ICON  DISCARDABLE    "otcicon.ico"

// Recurso de version: es lo que Windows ensena en Propiedades -> Detalles del
// otclient.exe (Copyright, Producto, Empresa). Constantes en numero para no
// depender de winver.h: FILEOS 0x40004 = VOS_NT_WINDOWS32, FILETYPE 1 = VFT_APP.
1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "The One"
            VALUE "FileDescription",  "The One - Cliente del juego"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "otclient"
            VALUE "LegalCopyright",   "Copyright (C) 2026 The One. Todos los derechos reservados."
            VALUE "OriginalFilename", "otclient.exe"
            VALUE "ProductName",      "The One"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
